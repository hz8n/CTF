<h1>Users</h1>
<table class="table table-bordered"><tr><th>Name</th><th>Email</th><th>Role</th><th>Points</th><th>Level</th></tr>
<% @users.each do |user| %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.role %></td><td><%= user.points %></td><td><%= user.level %></td></tr><% end %>
</table>
