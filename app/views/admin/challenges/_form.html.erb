<%= form_with model: [:admin, @challenge], class: "card p-4" do |f| %>
  <% @challenge.errors.full_messages.each do |msg| %><div class="alert alert-danger"><%= msg %></div><% end %>
  <%= f.label :title %><%= f.text_field :title, class: "form-control mb-3", required: true %>
  <%= f.label :category %><%= f.select :category, Challenge::CATEGORIES, {}, class: "form-select mb-3" %>
  <%= f.label :difficulty %><%= f.select :difficulty, Challenge::DIFFICULTIES, {}, class: "form-select mb-3" %>
  <%= f.label :points %><%= f.number_field :points, class: "form-control mb-3", min: 1, required: true %>
  <%= f.label :description %><%= f.text_area :description, class: "form-control mb-3", rows: 7, required: true %>
  <%= f.label :answer %><%= f.text_field :answer, class: "form-control mb-3", required: true %>
  <%= f.label :hint %><%= f.text_area :hint, class: "form-control mb-3", rows: 3 %>
  <%= f.submit class: "btn btn-success" %>
<% end %>
