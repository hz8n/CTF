<div class="card p-4">
  <h1><%= @challenge.title %></h1>
  <p><strong>Category:</strong> <%= @challenge.category %></p>
  <p><strong>Difficulty:</strong> <%= @challenge.difficulty %></p>
  <p><strong>Points:</strong> <%= @challenge.points %></p>
  <pre class="training-data"><%= @challenge.description %></pre>
  <button class="btn btn-outline-warning mb-3" type="button" onclick="document.getElementById('hint').classList.toggle('d-none')">Show Hint</button>
  <div id="hint" class="alert alert-info d-none"><%= @challenge.hint.presence || "No hint available." %></div>
  <% if @solved %><div class="alert alert-success">You already solved this challenge.</div><% end %>
  <%= form_with model: [@challenge, @attempt] do |f| %>
    <%= f.label :submitted_answer, "Submit answer" %>
    <%= f.text_field :submitted_answer, class: "form-control mb-3", required: true %>
    <%= f.submit "Submit", class: "btn btn-success" %>
  <% end %>
</div>
