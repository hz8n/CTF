<!DOCTYPE html>
<html>
<head>
  <title>Cyber Range Training Platform</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark border-bottom border-success">
  <div class="container">
    <%= link_to "Cyber Range", root_path, class: "navbar-brand fw-bold" %>
    <div class="ms-auto d-flex gap-2">
      <% if logged_in? %>
        <% if current_user.admin? %>
          <%= link_to "Admin", admin_root_path, class: "btn btn-outline-success btn-sm" %>
          <%= link_to "Challenges", admin_challenges_path, class: "btn btn-outline-light btn-sm" %>
          <%= link_to "Reports", admin_reports_path, class: "btn btn-outline-light btn-sm" %>
        <% else %>
          <%= link_to "Dashboard", dashboard_path, class: "btn btn-outline-success btn-sm" %>
          <%= link_to "Challenges", challenges_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>
        <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-danger btn-sm" %>
      <% else %>
        <%= link_to "Login", login_path, class: "btn btn-outline-light btn-sm" %>
        <%= link_to "Register", register_path, class: "btn btn-success btn-sm" %>
      <% end %>
    </div>
  </div>
</nav>
<main class="container py-4">
  <% flash.each do |type, message| %>
    <div class="alert <%= type == 'alert' ? 'alert-danger' : 'alert-success' %>"><%= message %></div>
  <% end %>
  <%= yield %>
</main>
</body>
</html>
