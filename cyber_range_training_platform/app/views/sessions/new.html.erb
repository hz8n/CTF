<h1>Login</h1>
<%= form_with url: login_path, class: "card p-4" do %>
  <label>Email</label><%= email_field_tag :email, nil, class: "form-control mb-3", required: true %>
  <label>Password</label><%= password_field_tag :password, nil, class: "form-control mb-3", required: true %>
  <%= submit_tag "Login", class: "btn btn-success" %>
<% end %>
