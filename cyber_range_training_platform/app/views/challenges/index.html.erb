<h1>Challenges</h1>
<%= form_with url: challenges_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-md-5"><%= select_tag :category, options_for_select([["All Categories", ""]] + @categories.map { |c| [c,c] }, params[:category]), class: "form-select" %></div>
  <div class="col-md-5"><%= select_tag :difficulty, options_for_select([["All Difficulties", ""]] + @difficulties.map { |d| [d,d] }, params[:difficulty]), class: "form-select" %></div>
  <div class="col-md-2"><%= submit_tag "Filter", class: "btn btn-success w-100" %></div>
<% end %>
<div class="row g-3">
<% @challenges.each do |challenge| %>
  <div class="col-md-4"><div class="card h-100 p-3">
    <h4><%= challenge.title %></h4>
    <p><%= challenge.category %> | <%= challenge.difficulty %></p>
    <p>Points: <%= challenge.points %></p>
    <p>Status: <%= challenge.solved_by?(current_user) ? "Solved" : "Unsolved" %></p>
    <%= link_to "Open Challenge", challenge_path(challenge), class: "btn btn-outline-success" %>
  </div></div>
<% end %>
</div>
